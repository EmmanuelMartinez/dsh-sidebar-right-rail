{
  "name": "@deepseek-ai/dsh-sidebar-right-rail",
  "version": "1.0.0",
  "description": "The right Sidebar's surface toggling for the DeepSeek Harness Web/Desktop client, for installations whose ui-sidebar-right predates the icon rail.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml"],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-shortcuts": "*",
    "@deepseek-ai/dsh-client-ui-renderer": "*",
    "@deepseek-ai/dsh-client-ui-session": "*",
    "@deepseek-ai/dsh-client-ui-theme": "*"
  }
}
